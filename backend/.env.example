# ─── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL on EC2 or local development
# Example: postgres://qpgen_user:your_secure_password@localhost:5432/qpgen_db
DATABASE_URL=
DATABASE_SSL_REQUIRE=false

# ─── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── AWS Cognito ────────────────────────────────────────────────────────────────
AWS_COGNITO_REGION=ap-south-1
AWS_COGNITO_USER_POOL_ID=ap-south-1_zHrjkaeQy
# PUBLIC app client with NO client secret (browser-direct auth, Path A). Create a
# new app client with "Generate client secret" UNCHECKED; put its ID here AND in
# the frontend's NEXT_PUBLIC_AWS_COGNITO_APP_CLIENT_ID — the two MUST match (the
# backend validates each token's aud/client_id against this). Leave empty until
# the no-secret client exists; the validator fails closed when unset.
AWS_COGNITO_APP_CLIENT_ID=

# ─── CORS / CSRF ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Required. Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PDF ingestion vision-caption controls.
# Keep concurrency at 3: the process-wide vision semaphore is sized from this, and
# 8 saturated the gpt-4o 30k TPM ceiling (~40 caption failures/book). Do not raise.
PDF_IMAGE_CAPTION_CONCURRENCY=3
PDF_IMAGE_MAX_CAPTIONS=40

# ─── Question Pool architecture ─────────────────────────────────────────────────
# Model 1 (chapter → ~84-question pool) and Model 2 (pool → paper) both run on
# this model. Separate from OPENAI_MODEL, which still backs answer-key and
# answer-script generation where quality matters more than throughput.
POOL_MODEL=gpt-4.1-mini

# Ceiling on the whole-chapter Markdown handed to Model 1. ~240k chars ≈ 60k
# tokens — far more than any single CBSE chapter. Exists only to stop a whole
# textbook being fed through as one "chapter".
CHAPTER_MD_MAX_CHARS=240000

# How image-bearing questions are produced:
#   generate — synthesise new diagrams with OPENAI_IMAGE_MODEL (default)
#   reuse    — write questions about figures extracted from the uploaded PDF
#   hybrid   — reuse the chapter's own figures first, synthesise the remainder
#
# COST WARNING: `generate` is by far the most expensive setting. At the default
# cap of 8 images it is roughly 90% of a generation's spend (~$0.32 of ~$0.37),
# and it pays to draw a diagram even when the chapter PDF already contains the
# real one. It is also the only setting that can put a scientifically wrong
# figure on a paper — AI-drawn circuit and ray diagrams are frequently subtly
# incorrect. Every synthesised question is tagged for teacher review in the UI.
# Switch to `hybrid` to keep synthetic diagrams only where the chapter has no
# usable figure; no code change or redeploy of the frontend is needed.
IMAGE_QUESTION_STRATEGY=generate

# Hard cap on image questions per pool. The single biggest cost lever in the
# pipeline. Set to 0 to disable image questions entirely.
IMAGE_QUESTIONS_PER_POOL=8

OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# Used only to report estimated spend on the generation's `pool` event, so cost
# is visible in the app rather than discovered on the invoice.
IMAGE_COST_USD_PER_IMAGE=0.04

# ─── AWS S3 — uploads + generated images (django-storages) ───────────────────────
# Leave bucket empty to use the local media folder. Use this bucket's OWN region.
# Example: qp-gen-pdfs lives in ap-southeast-2 (Sydney) — VERIFY against the console.
AWS_STORAGE_BUCKET_NAME=
# For EC2 production deployment, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# empty to automatically use the EC2 IAM Instance Profile credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=ap-southeast-2
AWS_QUERYSTRING_EXPIRE=900

# ─── AWS S3 — HSAT shared textbooks (read-only source PDFs) ──────────────────────
# This bucket may live in a DIFFERENT region than the uploads bucket. Each S3
# client signs for its own bucket's region or SigV4 fails (403
# AuthorizationHeaderMalformed). Leave empty to reuse the uploads bucket above.
# Example: storagetank-hsat lives in ap-south-1 (Mumbai) — VERIFY against the console.
HSAT_S3_BUCKET=
HSAT_S3_REGION=ap-south-1

# Optional AV scanning (ClamAV)
# Set to true to enable virus scanning on uploads
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Max upload size in bytes (default 100 MB)
MAX_UPLOAD_SIZE_BYTES=104857600
