# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon or any Postgres provider).
# Example: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ─── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_DAYS=7
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=qp-gen

# ─── CORS / CSRF ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Required. Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PDF ingestion vision-caption controls
PDF_IMAGE_CAPTION_CONCURRENCY=8
PDF_IMAGE_MAX_CAPTIONS=40

# Optional S3 / MinIO settings (leave empty to use local media folder)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_QUERYSTRING_EXPIRE=3600

# Optional AV scanning (ClamAV)
# Set to true to enable virus scanning on uploads
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Max upload size in bytes (default 100 MB)
MAX_UPLOAD_SIZE_BYTES=104857600
