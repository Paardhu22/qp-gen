# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon or any Postgres provider).
# Example: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ─── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_DAYS=7
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=qp-gen

# ─── CORS / CSRF ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Required. Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
