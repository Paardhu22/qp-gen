# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with the pgvector extension. Required — settings.py raises without
# it (the only exception is `manage.py test`, which swaps to in-memory SQLite).
# Example: postgres://qpgen_user:your_secure_password@localhost:5432/qpgen_db
#
# NOTE: settings.py calls load_dotenv(override=True), so this file WINS over a
# DATABASE_URL exported in your shell. Edit here, not in the environment.
#
# Local dev container (plain postgres:16 will not work — no pgvector):
#   docker run -d --name qpgen-postgres -p 5433:5432 \
#     -e POSTGRES_USER=qpgen -e POSTGRES_PASSWORD=qpgen -e POSTGRES_DB=qpgen \
#     -v qpgen-pgdata:/var/lib/postgresql/data pgvector/pgvector:pg16
#   docker exec qpgen-postgres psql -U qpgen -d qpgen -c 'CREATE EXTENSION IF NOT EXISTS vector;'
DATABASE_URL=
DATABASE_SSL_REQUIRE=false

# ─── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── AWS Cognito ────────────────────────────────────────────────────────────────
AWS_COGNITO_REGION=ap-south-1
AWS_COGNITO_USER_POOL_ID=ap-south-1_zHrjkaeQy
# PUBLIC app client with NO client secret (browser-direct auth, Path A). Create a
# new app client with "Generate client secret" UNCHECKED; put its ID here AND in
# the frontend's NEXT_PUBLIC_AWS_COGNITO_APP_CLIENT_ID — the two MUST match (the
# backend validates each token's aud/client_id against this). Leave empty until
# the no-secret client exists; the validator fails closed when unset.
AWS_COGNITO_APP_CLIENT_ID=250mqujjmvgo8s5r7cbmorb8bc

# ─── CORS / CSRF ───────────────────────────────────────────────────────────────
# The canonical frontend origin. Also builds the links in password-reset
# emails, so keep it to one value.
FRONTEND_URL=http://localhost:3000
# Any OTHER browser origins allowed to call the API, comma-separated. CORS
# matches the Origin header exactly, so https://example.com and
# https://www.example.com are different origins — name both if the site
# answers on both, or requests from one of them fail CORS.
# EXTRA_ALLOWED_ORIGINS=https://www.hsatedu.in,https://staging.hsatedu.in
EXTRA_ALLOWED_ORIGINS=

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Required. Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Per-request ceiling on every OpenAI call. The SDK default is 600s, which
# outlives gunicorn's worker timeout — a hung call then gets the worker killed
# mid-stream instead of failing cleanly. Keep this BELOW gunicorn's --timeout.
OPENAI_TIMEOUT_SECONDS=120

# PDF ingestion vision-caption controls.
# Keep concurrency at 3: the process-wide vision semaphore is sized from this, and
# 8 saturated the gpt-4o 30k TPM ceiling (~40 caption failures/book). Do not raise.
PDF_IMAGE_CAPTION_CONCURRENCY=3
PDF_IMAGE_MAX_CAPTIONS=40

# ─── Ingestion cost controls ────────────────────────────────────────────────────
# Store each figure in an ingested chapter as its own chunk — one S3 PUT per
# figure, in the path of "apply this source". Off because nothing in the paper
# pipeline reads them: Model 1 gets the chapter as Markdown and forbids
# figure-dependent questions, and editor images are drawn on demand. Turn on if
# figure-grounded retrieval (retrieve_relevant_chunks require_image) matters again.
INGEST_EXTRACT_FIGURES=false

# Chunks per embeddings request. Each batch is one OpenAI round trip inside the
# ingest; chunks are ~250 tokens, so 256 of them is ~64k — well under the 300k
# per-request ceiling for text-embedding-3-*.
INGEST_EMBED_BATCH_SIZE=256

# Compute retrieval embeddings during ingestion at all. Only answer-script
# generation and the flag-gated apps/question_generation/ engine read them; the
# pool pipeline reads chunk text, never vectors. Set false to make ingestion
# purely local work, at the cost of answer-script context for anything ingested
# while it is off.
INGEST_EMBEDDINGS_ENABLED=true

# How many chapter ingests may run at once, across BOTH uploaded PDFs and
# library books. Each one is a daemon thread that writes DocumentChunk batches
# and calls the embeddings API, so an unbounded fan-out (selecting 15 chapters
# started 15 threads) oversubscribes the database write lock and the OpenAI
# quota together — on SQLite that surfaces as "database is locked". Threads
# past the limit queue instead of failing. Clamped to 1..16.
INGEST_MAX_CONCURRENCY=4

# ─── Question Pool architecture ─────────────────────────────────────────────────
# Model 1 (chapter → ~84-question pool) and Model 2 (pool → paper) both run on
# this model. Separate from OPENAI_MODEL, which still backs answer-key and
# answer-script generation where quality matters more than throughput.
POOL_MODEL=gpt-4.1-mini

# ─── Dashboard assistant ────────────────────────────────────────────────────────
# The conversational model behind the dashboard. It gathers paper requirements
# and hands them to the generator; it never writes a question, so it is sized
# for latency and cost rather than quality.
CHAT_MODEL=gpt-4.1-mini

# Ceiling on the whole-chapter Markdown handed to Model 1. ~240k chars ≈ 60k
# tokens — far more than any single CBSE chapter. Exists only to stop a whole
# textbook being fed through as one "chapter".
CHAPTER_MD_MAX_CHARS=240000

# ─── How big a pool Model 1 writes ──────────────────────────────────────────
# Model 2 selects; it never writes. So the only thing deciding whether it has
# real choice is how far the pool over-provisions the blueprint.
#
# Exactly what the paper needs, plus only the spares something requires: one
# per OR-choice slot, and enough to derive Sets B/C when more than one set is
# requested. Slots the Blueprint Builder marked "from my bank" are not
# generated at all.
# Spare questions written beyond the exact slot count, as a percentage, to
# absorb normalisation losses (malformed objects, content-hash duplicates, a
# failed batch). 0 = literally exact, accepting occasional short papers.
POOL_EXACT_MARGIN_PERCENT=15

# NOTE: the speculative image STAGE was removed from the generation cycle.
# IMAGE_QUESTION_STRATEGY, IMAGE_QUESTIONS_PER_POOL and IMAGE_COST_USD_PER_IMAGE
# no longer exist; nothing reads them if they are still set. The OPENAI_IMAGE_*
# settings below are for the on-demand editor feature that replaced it.

# ─── On-demand question images ──────────────────────────────────────────────
# Nothing is drawn during generation. A teacher picks a question in the editor,
# chooses a style, and pays for exactly that one image — so there is no
# per-pool cap and no strategy to configure.
#
# Quality is `high` deliberately: a low-tier render draws labels as approximate
# letter shapes, and a student cannot answer "identify the part marked B" when
# B is a smudge.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_CONCURRENCY=1

# ─── AWS S3 — uploads + extracted figures (django-storages) ─────────────────────
# Leave bucket empty to use the local media folder. Use this bucket's OWN region.
# Example: qp-gen-pdfs lives in ap-southeast-2 (Sydney) — VERIFY against the console.
AWS_STORAGE_BUCKET_NAME=
# For EC2 production deployment, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# empty to automatically use the EC2 IAM Instance Profile credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=ap-southeast-2
AWS_QUERYSTRING_EXPIRE=900

# ─── AWS S3 — HSAT shared textbooks (read-only source PDFs) ──────────────────────
# This bucket may live in a DIFFERENT region than the uploads bucket. Each S3
# client signs for its own bucket's region or SigV4 fails (403
# AuthorizationHeaderMalformed). Leave empty to reuse the uploads bucket above.
# Example: storagetank-hsat lives in ap-south-1 (Mumbai) — VERIFY against the console.
HSAT_S3_BUCKET=
HSAT_S3_REGION=ap-south-1

# Optional AV scanning (ClamAV)
# Set to true to enable virus scanning on uploads
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Max upload size in bytes (default 100 MB)
MAX_UPLOAD_SIZE_BYTES=104857600

# ─── Email (invites, approvals, role changes, password reset) ──────────────────
# Brevo SMTP relay. Leave EMAIL_BACKEND on the console backend for local work —
# every message then prints into the runserver log instead of being delivered,
# which is what you want while testing against real teachers' addresses.
#
# EMAIL_HOST_USER is the Brevo *login* (…@smtp-brevo.com) shown on their SMTP
# settings page — NOT the from-address. EMAIL_HOST_PASSWORD is the SMTP key
# (starts `xsmtpsib-`), which is a different credential from the Brevo REST API
# key. Never commit either; this file carries placeholders only.
#
# TWO Brevo settings will silently stop mail, and both fail in ways that look
# like "no email arrives" rather than an error, because services/email_service.py
# logs send failures and lets the request succeed:
#
#   1. Authorized IPs. Brevo rejects AUTH from an unlisted address with
#      `525 5.7.1 Unauthorized IP address`. Every machine that sends — your
#      laptop AND the EC2 host's elastic IP — must be listed under
#      SMTP & API → Authorized IPs, or IP restriction must be turned off.
#   2. Sender verification. DEFAULT_FROM_EMAIL must be a validated Brevo sender,
#      or any address on a domain you have authenticated with them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=QP Gen <noreply@hsatedu.in>

# ─── Diagnostics ───────────────────────────────────────────────────────────────
# Routes developer endpoints that spend real OpenAI budget on hard-coded inputs
# (/api/generation/test-science-engine). Defaults to DJANGO_DEBUG. Leave false
# in production: any authenticated account could otherwise run up the bill.
ENABLE_TEST_ENDPOINTS=false
